@page "/login"

@using FarmApp.AdminComponents.Attributes
@using FarmApp.AdminComponents.Layouts
@attribute [Unauthorized]
@layout LoginLayout

<div class="form-wrapper">
    <div class="form login-form">
        <h3 class="form-header">Sign in</h3>
        <EditForm Model="Model" OnValidSubmit="OnSubmitAsync">
            <DataAnnotationsValidator />

            <div class="form-group">
                <label for="email">Email</label>
                <input id="email" class="form-control" type="email" autocomplete="email" aria-describedby="email-validation" @bind="Model.Email" />
                <div id="email-validation" class="validation-error">
                    <ValidationMessage For="() => Model.Email" />
                </div>
            </div>

            <div class="form-group">
                <label for="password">Password</label>
                <div class="password-input">
                    <input id="password" class="form-control" type="@(_showPassword ? "text" : "password")" autocomplete="current-password" aria-describedby="password-validation" @bind="Model.Password" />
                    <button type="button" class="password-toggle" @onclick="ToggleShowPassword" title="@(_showPassword ? "Hide password" : "Show password")" aria-label="@(_showPassword ? "Hide password" : "Show password")" aria-pressed="@_showPassword">
                        <span class="icon @(_showPassword ? "eye-off" : "eye")"></span>
                    </button>
                </div>
                <div id="password-validation" class="validation-error">
                    <ValidationMessage For="() => Model.Password" />
                </div>
            </div>

            <button type="submit" class="btn btn-success full-width">Login</button>
        </EditForm>
    </div>
</div>
