@using Bch.Components.Modal
<BchModal Width="25%"
		  Height="auto"
		  @bind-Show="Opened"
		  ShowOverlay="true"
		  CloseOnOverlayClicked="true"
		  OnOverlayClicked="() => Opened = false">
	<div class="modal-container">
		<div class="modal-header">
			<h4>@Title</h4>
			<button type="button" class="close-button" @onclick="() => Opened = false">
				<img src="_content/FarmApp.AdminComponents/icons/close.svg" alt="Close" />
			</button>
		</div>
		
		<div class="modal-content">
			<p>@Info</p>
		</div>

		<div class="modal-footer">
			<button class="btn btn-success"
					@onclick="() => Opened = false">
				Ok
			</button>
		</div>
	</div>
</BchModal>
