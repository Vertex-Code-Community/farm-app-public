{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "FarmAppSqlServerConnection": "Host=localhost;Port=5432;Database=farm-app;Username=postgres;Password=postgres"
  },
  "JwtConnectionOptions": {
    "Issuer": "MyAuthServer",
    "Audience": "MyAuthClient",
    "LifetimeAccessToken": 5,
    "LifetimeRefreshToken": 10080,
    "LengthRefreshToken": 32,
    "SecretKey": "YOUR-SECRET-KEY-HERE"
  },
  "UsersOptions": {
    "Users": [
      {
        "Email": "testuser1@example.com",
        "Password": "Password123!"
      },
      {
        "Email": "testuser2@example.com",
        "Password": "Password123!"
      }
    ]
  },
  "VerificationConfiguration": {
    "Ttl": 5
  },
  "EmailConfiguration": {
    "Server": "smtp.gmail.com",
    "Port": 587,

    "SenderName": "FarmApp",
    "SenderEmail": "YOUR-EMAIL-ADDRESS-HERE",

    "UserName": "YOUR-EMAIL-USERNAME-HERE",
    "Password": "YOUR-EMAIL-PASSWORD-HERE"
  },
  "MediaSigningSecret": "WOO-WOO-WOOOOOOOO",

  "WeatherApiConfiguration": {
    "ApiKey": "YOUR-WEATHER-API-KEY-HERE"
  },
  "PushSharp": {
    "Fcm": {
      "ProjectId": "YOUR-FCM-PROJECT-ID-HERE"
    }
  },
  "FFmpegOptions": {
    "BinaryPath": "ffmpeg",
    "TimeoutSeconds": 30
  }
}
