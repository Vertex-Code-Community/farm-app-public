@using Microsoft.AspNetCore.Components.Forms
@inherits InputBase<string>

<div class="password-input-cont">
    <InputComponent Label="@Label" 
                    Type="@(showPassword ? "text" : "password")" 
                    IconUrl="@($"_content/FarmApp.Components/img/auth-icons/{(showPassword ? "eye" : "eye-off")}.svg")"
                    Value="@CurrentValueAsString" 
                    ValueChanged="OnInternalValueChanged" 
                    ValueExpression="ValueExpression" />

    <button class="passwrod-view-toggle-btn"
            type="button"
            @onclick="() => showPassword = !showPassword">
    </button>
</div>