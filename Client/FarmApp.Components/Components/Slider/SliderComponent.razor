@typeparam TItem

<div class="slider-container" @ref="sliderRef">
    @{
        var itemList = Items?.ToList();
    }
    
    @if (itemList != null)
    {
        @for (int i = 0; i < itemList.Count; i++)
        {
            var index = i;
            var item = itemList[index];

            <div class="slider-item" data-index="@index">
                @ItemTemplate(item)
            </div>
        }
    }
</div>