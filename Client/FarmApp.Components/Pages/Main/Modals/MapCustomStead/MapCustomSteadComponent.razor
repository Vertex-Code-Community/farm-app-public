@using FarmApp.Services.Services.Interfaces
@using FarmApp.Components.Components.RemoveConfirmation

<div class="property-stead-wrapper">
    
    <div class="header">
        <div class="name">Ділянка</div>
        <div class="icons">
            @if (AuthStateProvider is { IsUserLoggedIn: true })
            {
                <div class="icon edit" @onclick="() => { IMapSteadService.InvokeSteadEdit(null, CustomStead.Id); }" ontouchstart="onRippleEffectTouchStartListener(event, true)"></div>
                <div class="icon remove" @onclick="() => { _showRemoveCustomSteadDialog = true; }" ontouchstart="onRippleEffectTouchStartListener(event, true)"></div>
            }
        </div>
    </div>

    <div class="data">
        @if (Area != 0)
        {
            <div class="line">
                <div class="name">Площа:</div>
                <div class="value">@(Math.Round(Area, 4, MidpointRounding.AwayFromZero).ToString(_nF))га</div>
            </div>
        }
    </div>

</div>

<RemoveConfirmationComponent @bind-IsOpened="_showRemoveCustomSteadDialog"
                             Question="Ви дійсно хочете видалити обрану ділянку?"
                             OnConfirm="OnRemoveCustomSteadAsync"/>