@attribute [Route(Constants.ClientRoutes.TypePasswordPage)]
@attribute [Layout(typeof(AuthLayout))]
@attribute [Unauthorized]
@attribute [StatusBarColor(Constants.StatusbarColors.WHITE)]

@using FarmApp.Components.Components.ButtonSpinner
@using FarmApp.Components.Components.PasswordInput
@using Microsoft.AspNetCore.Components.Forms

@{
    var offsetTop = !OperatingSystem.IsIOS() ? ScreenOffsetProvider.Top : 0;
}

<div class="type-password-container @(_isLoading ? "loading" : "")">
    <div class="type-password-info">
        <div data-animate class="type-password-title">
            @Localizer["New-Password_Title"]
        </div>
    </div>

    <EditForm EditContext="_editContext" OnValidSubmit="OnResetClickedAsync">
        <DataAnnotationsValidator />

        <div class="type-password-form">
            <div class="type-password-form-control">
                <div class="type-password-form-field pass-w-req-field ignore-error @(_resetPasswordViewModel.Password?.Length > 0 ? "has-password" : "")">
                    <PasswordInputComponent @bind-Value="_resetPasswordViewModel.Password" Label="@Localizer["Sign-up_Password"]" />
                    <div class="pass-requirements">
                        <p>@Localizer["Sign-up_Validation_Password"]</p>
                        <ul>
                            <li class="@(_resetPasswordViewModel.Password?.Length > 0 ? (_resetPasswordViewModel.Password.Length >= 8 ? "green-text" : "red-text") : "")">@Localizer["Sign-up_Validation_Characters"]</li>
                            <li class="@(_resetPasswordViewModel.Password?.Length > 0 ? (_resetPasswordViewModel.Password.Any(char.IsUpper) ? "green-text" : "red-text") : "")">@Localizer["Sign-up_Validation_Uppercase"] (A-Z)</li>
                            <li class="@(_resetPasswordViewModel.Password?.Length > 0 ? (_resetPasswordViewModel.Password.Any(char.IsLower) ? "green-text" : "red-text") : "")">@Localizer["Sign-up_Validation_Lowercase"] (a-z)</li>
                            <li class="@(_resetPasswordViewModel.Password?.Length > 0 ? (_resetPasswordViewModel.Password.Any(char.IsNumber) ? "green-text" : "red-text") : "")">@Localizer["Sign-up_Validation_Digit"] (0-9)</li>
                            <li class="@(_resetPasswordViewModel.Password?.Length > 0 ? (_resetPasswordViewModel.Password.All(char.IsAscii) ? "green-text" : "red-text") : "")">@Localizer["Sign-up_Validation_Latin"] (A-Z)</li>
                            <li class="@(_resetPasswordViewModel.Password?.Length > 0 ? (_resetPasswordViewModel.Password.All(c => !char.IsWhiteSpace(c)) ? "green-text" : "red-text") : "")">@Localizer["Sign-up_Validation_No-Spaces"]</li>
                        </ul>
                    </div>
                </div>

                <div class="type-password-form-field">
                    <PasswordInputComponent Label="@Localizer["New-Password_Confirm-Password"]" @bind-Value="_resetPasswordViewModel.ConfirmPassword" />
                </div>

            </div>
            <div class="type-password-actions">
                <div class="type-password-button">
                    <ButtonComponent Type="submit" Disabled="@(!_isFormValid)" Name="@Localizer["New-Password_Create"]" />
                </div>
            </div>
        </div>
    </EditForm>

</div>

<style>
    body {
        background: white;
    }

        body .auth-layout-container .auth-content:has(.type-password-container) {
            max-height: calc(294px + var(--global-error-offset));
        }

        body .auth-layout-container .auth-content:has(.pass-w-req-field:focus-within),
        body .auth-layout-container .auth-content:has(.pass-w-req-field.has-password) {
            max-height: calc(451px + var(--global-error-offset));
        }
</style>