@using FarmApp.Components.Components.PasswordInput
@using FarmApp.Components.Components.TopNavigation
@attribute [Route(Constants.ClientRoutes.ChangePasswordPage)]
@attribute [Authorize]
@attribute [StatusBarColor(Constants.StatusbarColors.WHITE)]

@layout PageLayout

<div class="profile-cont flex-column">
    <TopNavigationComponent Title="Зміна паролю"
                            IconUrl="_content/FarmApp.Components/img/shared/check-02.svg"
                            IconCallback="SaveNewPassword" />

    <div class="flex-column profile-info" style="padding-bottom: @(ScreenOffsetProvider.Bottom)px">
        <EditForm EditContext="_editContext">
            <div class="change-password-card">
                <div class="password-field-stack">
                    <span class="field-label">Поточний пароль</span>
                    <PasswordInputComponent Label="Введіть поточний пароль" @bind-Value="_viewModel.OldPassword" />
                </div>

                <div class="password-field-stack">
                    <span class="field-label">Новий пароль</span>
                    <PasswordInputComponent Label="Новий пароль" @bind-Value="_viewModel.NewPassword" />
                </div>

                <div class="pass-requirements" role="status" aria-live="polite">
                    <p class="pass-requirements-title">Вимоги до пароля</p>
                    <div class="req-list">
                        <div class="@ReqRowClass(p => p.Length >= 8)">Щонайменше 8 символів</div>
                        <div class="@ReqRowClass(p => p.Any(char.IsUpper))">Одна велика літера (A–Z)</div>
                        <div class="@ReqRowClass(p => p.Any(char.IsLower))">Одна мала літера (a–z)</div>
                        <div class="@ReqRowClass(p => p.Any(char.IsNumber))">Одна цифра (0–9)</div>
                        <div class="@ReqRowClass(p => p.All(char.IsAscii))">Лише латинські символи (A–Z, a–z, 0–9)</div>
                        <div class="@ReqRowClass(p => p.All(c => !char.IsWhiteSpace(c)))">Без пробілів</div>
                    </div>
                </div>

                <div class="password-field-stack">
                    <span class="field-label">Підтвердження</span>
                    <PasswordInputComponent Label="Повторіть новий пароль" @bind-Value="_viewModel.ConfirmNewPassword" />
                </div>
            </div>
        </EditForm>
    </div>
</div>
