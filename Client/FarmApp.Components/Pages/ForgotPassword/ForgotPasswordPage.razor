@using FarmApp.Components.Components.AuthHeader
@using FarmApp.Components.Components.ErrorMessage
@using Microsoft.AspNetCore.Components.Forms
@attribute [Route(Constants.ClientRoutes.ForgotPasswordPage)]
@attribute [Layout(typeof(AuthLayout))]
@attribute [Unauthorized]
@attribute [StatusBarColor(Constants.StatusbarColors.WHITE)]

@{
    var offsetTop = !OperatingSystem.IsIOS() ? ScreenOffsetProvider.Top : 0;
}

<div class="forgot-pass-container">
    <AuthHeaderComponent Title="@Localizer["Password-Reset_Title"]" BackCallback="() => NavigationService.NavigateTo(Constants.ClientRoutes.SignInPage)" />

    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <div class="error">
            @_errorMessage
        </div>
    }
    <EditForm EditContext="_editContext" OnValidSubmit="OnSendCodeCLicked">
         <DataAnnotationsValidator />

        <div class="forgot-pass-form">
            <p data-animate>@Localizer["Password-Reset_Description"]</p>
            <div class="forgot-pass-form-control">
                <div class="forgot-pass-form-field">
                    <InputComponent Label="@Localizer["Password-Reset_Email"]" Type="email" IconName="mail" @bind-Value="_forgotPasswordRequestModel.Email"/>
                </div>
            </div>
            <ButtonComponent Disabled="@(!_isFormValid)" Loading = "_isLoading" Type="submit" Name="@Localizer["Password-Reset_Send"]" />
        </div>
    </EditForm>

</div>

<style>
    body {
        background: white;
    }

        body .auth-layout-container .auth-content:has(.forgot-pass-container) {
            max-height: calc(320px + var(--global-error-offset));
        }

        body .auth-layout-container .auth-content:has(.forgot-pass-container .error) {
            max-height: calc(360px + var(--global-error-offset));
        }
</style>