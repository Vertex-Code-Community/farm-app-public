<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:FarmApp.Mobile"
             xmlns:common="clr-namespace:Bch.Components.Modal;assembly=Bch.Components.Modal"
             xmlns:maplibre="clr-namespace:MaplibreMaui;assembly=Maplibre.Maui"
             xmlns:controls="clr-namespace:FarmApp.Mobile.Controls"
             x:Class="FarmApp.Mobile.MainPage"
             BackgroundColor="{DynamicResource PageBackgroundColor}">

    <controls:HitRoutingAbsoluteLayout x:Name="RootLayout">

        <maplibre:MaplibreView x:Name="MaplibreView"
                               StartLatitude="49.985983"
                               StartLongitude="36.233640"
                               StartZoom="6"
                               AbsoluteLayout.LayoutBounds="0,0,1,1" 
                               AbsoluteLayout.LayoutFlags="All"/>

        <controls:CustomBlazorWebView x:Name="BlazorWebView"
                             HostPage="wwwroot/index.html"
                             BackgroundColor="Transparent"
                             AbsoluteLayout.LayoutBounds="0,0,1,1"
                             AbsoluteLayout.LayoutFlags="All">
        
            <BlazorWebView.RootComponents>
        
                <RootComponent Selector="#app"
                               ComponentType="{x:Type local:Main}" />
        
                <RootComponent Selector="#modal"
                               ComponentType="{x:Type common:Root.BchRootModal}" />
        
            </BlazorWebView.RootComponents>
        
        </controls:CustomBlazorWebView>

        <AbsoluteLayout x:Name="NativeLoaderOverlay"
                        BackgroundColor="#0D0D0D"
                        AbsoluteLayout.LayoutBounds="0,0,1,1"
                        AbsoluteLayout.LayoutFlags="All"
                        IsVisible="True"
                        InputTransparent="False">
            <ActivityIndicator IsRunning="True"
                               Color="White"
                               WidthRequest="40"
                               HeightRequest="40"
                               AbsoluteLayout.LayoutBounds="0.5,0.5,AutoSize,AutoSize"
                               AbsoluteLayout.LayoutFlags="PositionProportional"/>
        </AbsoluteLayout>
        
    </controls:HitRoutingAbsoluteLayout>

</ContentPage>